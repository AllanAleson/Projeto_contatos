{
  "name": "projeto-contatos",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app-contatos",
    "api"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "app": "npm run start --workspace app-contatos",
    "api": "npm run dev --workspace contatos-api",
    "check": "npm run typecheck --workspace app-contatos && npm run check --workspace contatos-api",
    "test": "npm run test --workspace contatos-api"
  }
}
